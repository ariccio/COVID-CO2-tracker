#!/usr/bin/env ruby
# Load debug logging helper early if available
debug_log_path = File.expand_path('../config/initializers/debug_logging.rb', __dir__)
if File.exist?(debug_log_path)
  require debug_log_path
  debug_log("Start of bin/rails")
else
  # Fallback to original behavior if initializer doesn't exist yet
  puts "#{Time.now.strftime("%H:%M:%S:%L")}: Start of bin/rails"
end
APP_PATH = File.expand_path('../config/application', __dir__)
require_relative '../config/boot'
require 'rails/commands'