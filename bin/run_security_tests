#!/usr/bin/env ruby
# frozen_string_literal: true

require 'optparse'
require 'colorize' if defined?(Colorize)

class SecurityTestRunner
  SECURITY_CATEGORIES = {
    'token' => 'Token Security',
    'sql' => 'SQL Injection',
    'rate' => 'Rate Limiting',
    'memory' => 'Memory Leak',
    'cors' => 'CORS',
    'integration' => 'Integration Security'
  }.freeze

  def initialize
    @options = parse_options
  end

  def run
    puts header
    
    if @options[:list]
      list_categories
      return
    end

    command = build_command
    puts "Running: #{command}\n\n"
    
    start_time = Time.now
    success = system(command)
    elapsed = Time.now - start_time
    
    puts footer(success, elapsed)
    exit(success ? 0 : 1)
  end

  private

  def parse_options
    options = {}
    
    OptionParser.new do |opts|
      opts.banner = "Usage: bin/run_security_tests [options]"
      
      opts.on('-c', '--category CATEGORY', SECURITY_CATEGORIES.keys,
              "Run specific category (#{SECURITY_CATEGORIES.keys.join(', ')})") do |c|
        options[:category] = c
      end
      
      opts.on('-f', '--fail-fast', 'Stop on first failure') do
        options[:fail_fast] = true
      end
      
      opts.on('-v', '--verbose', 'Verbose output') do
        options[:verbose] = true
      end
      
      opts.on('-l', '--list', 'List available test categories') do
        options[:list] = true
      end
      
      opts.on('-p', '--parallel', 'Run tests in parallel (if available)') do
        options[:parallel] = true
      end
      
      opts.on('-h', '--help', 'Show this help') do
        puts opts
        exit
      end
    end.parse!
    
    options
  end

  def build_command
    cmd = ['bundle', 'exec', 'rspec']
    
    # Add spec path
    if @options[:category]
      cmd << 'spec/security/export_system_security_spec.rb'
      cmd << '-e' << "\"#{SECURITY_CATEGORIES[@options[:category]]}\""
    else
      cmd << 'spec/security/'
    end
    
    # Add options
    cmd << '--fail-fast' if @options[:fail_fast]
    cmd << '--format documentation' if @options[:verbose]
    cmd << '--format progress' unless @options[:verbose]
    
    cmd.join(' ')
  end

  def list_categories
    puts "\nAvailable Security Test Categories:\n\n"
    SECURITY_CATEGORIES.each do |key, description|
      puts "  #{key.ljust(12)} - #{description}"
    end
    puts "\nExample usage:"
    puts "  bin/run_security_tests -c token    # Run token security tests"
    puts "  bin/run_security_tests -c sql -v   # Run SQL injection tests verbosely"
    puts "  bin/run_security_tests --fail-fast # Run all, stop on first failure\n\n"
  end

  def header
    <<~HEADER
    ╔═══════════════════════════════════════════════════════════╗
    ║         COVID CO2 Tracker - Security Test Suite          ║
    ╚═══════════════════════════════════════════════════════════╝
    HEADER
  end

  def footer(success, elapsed)
    status = success ? '✓ PASSED' : '✗ FAILED'
    color = success ? :green : :red
    
    <<~FOOTER
    
    ═══════════════════════════════════════════════════════════
    Test Suite: #{status}
    Time Elapsed: #{elapsed.round(2)} seconds
    ═══════════════════════════════════════════════════════════
    FOOTER
  end
end

# Run if executed directly
if __FILE__ == $0
  SecurityTestRunner.new.run
end